export const calcularAhorro = (precio, oferta) => {
    return (precio - oferta).toFixed(2);
};

export default function obtenerResumenProducto(producto) {
    return `Producto: ${producto.titulo} | Precio: $${producto.precioActual} | Color: ${producto.color})`;
}
